# ================================================
# YOLO Object Detection (trained model)
# ================================================
# Leave YOLO_PYTHON blank to auto-detect backend/yolo/.venv/Scripts/python.exe
YOLO_PYTHON=

# Leave YOLO_MODEL_PATH blank to auto-detect backend/yolo/weights_yolo11n/best.pt
YOLO_MODEL_PATH=

# Detection confidence threshold (0.0 - 1.0)
YOLO_CONF_THRESHOLD=0.35

# IOU threshold for NMS (0.0 - 1.0)
YOLO_IOU_THRESHOLD=0.45

# Max inference time before killing Python process (ms)
YOLO_TIMEOUT_MS=60000